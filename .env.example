# Opsional. Password dan secret cookie disimpan di database (tabel settings).
# Isi MONETARY_PASSWORD hanya untuk bootstrap DB yang masih kosong; setelah itu ganti lewat Setelan > Akun.
# MONETARY_PASSWORD=
MONETARY_DB=/app/data/monetary.db

# Google SSO (opsional). Satu-satunya tempat mengaturnya — tidak ada formnya di aplikasi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED=

# Pengiriman surel (opsional): verifikasi email & tautan setel ulang password.
# Satu-satunya tempat mengaturnya — tidak ada formnya di aplikasi.
RESEND_API_KEY=
MAIL_SENDER=noreply@contoh.com
MAIL_NAME=Muara
